# Copy to .env (gitignored). NEVER commit real credentials.

# Red Hat pull secret JSON file (console.redhat.com)
PULL_SECRET_FILE=/path/to/pull-secret.json

# Optional inline (prefer file)
# PULL_SECRET=

# SSH public key for cluster nodes
SSH_PUBLIC_KEY_FILE=$HOME/.ssh/id_ed25519.pub
# SSH_PUBLIC_KEY=

# Optional: existing hub kubeconfig
# KUBECONFIG=/path/to/hub/kubeconfig

# Optional: OpenShift API login helpers (future ACM ops)
# OC_SERVER=https://api.hub.lab.example.net:6443
# OC_USER=kubeadmin
# OC_PASSWORD=
