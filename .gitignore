# Build artifacts
/bin/
*.exe
*.test
*.out

# Generated lab data (ISOs, auth, haproxy, MockUps, etc.)
/data/

# Embedded UI build output is committed as placeholder; rebuilt by make web
cmd/mock-me/static/*
!cmd/mock-me/static/.gitkeep
web/node_modules/
web/dist/

# Local kubeconfigs — never commit
kubeconfig
kubeconfig.*
*.kubeconfig

# Secrets
.env
.env.*
!.env.example
pull-secret.json
**/pull-secret*.json

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
